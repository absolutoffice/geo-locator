# GeoLocator example configuration.
# Copy this file to a private location (e.g. /srv/my-app/private/geolocator.env)
# and fill in real values. Never commit the private copy.
# GeoLocator never searches for .env files: pass the path explicitly to
# GeoLocatorFactory::configFromEnvironment().

# Required: base64url-encoded 32-byte secret used by the visitor cache
# authentication. The placeholder below is NOT a usable secret. Generate one with:
#   php -r 'echo rtrim(strtr(base64_encode(random_bytes(32)), "+/", "-_"), "="), PHP_EOL;'
GEOLOCATION_SECRET=YOUR_GENERATED_BASE64URL_32_BYTE_SECRET

# Required for public-IP lookups: absolute path to an application-owned
# GeoLite2 City MMDB, stored outside vendor/.
MAXMIND_DATABASE_PATH=/srv/my-app/var/geoip/GeoLite2-City.mmdb

# Writable directory for updater runtime state and lock files.
MAXMIND_STATE_DIR=/srv/my-app/var/geoip/.state

# Optional: visitor cache cookie settings (defaults shown commented).
#GEOLOCATION_CACHE_TTL_DAYS=7
#GEOLOCATION_COOKIE_SECURE=1
#GEOLOCATION_COOKIE_HTTPONLY=1
#GEOLOCATION_COOKIE_SAMESITE=Lax
#GEOLOCATION_COOKIE_PATH=/

# Optional: trusted-proxy handling (provider must be one of the supported
# values; "none" disables trusted-proxy parsing).
#GEOLOCATION_TRUSTED_PROXY_PROVIDER=none
#GEOLOCATION_TRUSTED_PROXIES=

# Optional: MaxMind updater credentials, only needed to run explicit
# database updates. Installing or loading the library never triggers updates.
#MAXMIND_ACCOUNT_ID=
#MAXMIND_LICENSE_KEY=
#MAXMIND_UPDATE_INTERVAL_DAYS=
#MAXMIND_PREFERRED_LOCALES=en
#MAXMIND_HTTP_TIMEOUT_SECONDS=
#MAXMIND_HTTP_MAX_ATTEMPTS=
